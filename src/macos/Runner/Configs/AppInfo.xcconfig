// Application-level settings for the macOS Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. Determines both the macOS window title and the output bundle name
// (`build/macos/Build/Products/Release/Bluepad32.app`) signed and notarized in CI.
PRODUCT_NAME = Bluepad32

// The unified reverse-DNS application bundle identifier across Apple/Android/Linux platforms.
PRODUCT_BUNDLE_IDENTIFIER = moe.retro.bluepad32

// The copyright displayed in macOS Finder and the About panel.
PRODUCT_COPYRIGHT = Copyright © 2024-2026 Ricardo Quesada. All rights reserved.
